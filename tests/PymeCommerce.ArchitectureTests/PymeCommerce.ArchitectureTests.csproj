<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: cada proyecto de tests es un ejecutable (Microsoft.Testing.Platform). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenciar el host trae todos los módulos que registra, así que los tests
         descubren módulos nuevos sin tener que agregarlos acá. -->
    <ProjectReference Include="..\..\src\Api\PymeCommerce.Api\PymeCommerce.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
